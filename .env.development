# Development Environment Variables Configuration
# 开发环境环境变量配置

# Base API endpoint for fetching companion data
# 与 API 文档一致的默认后端域名（可用 .env.*.local 覆盖）
VITE_API_BASE_URL=https://jiusdai.eu.cc

# Target URL for the UniApp Web3 Tron payment system in local development
# 本地开发环境中对接的 UniApp Web3 波场支付系统的端口与路径
VITE_PAYMENT_SYSTEM_URL=
